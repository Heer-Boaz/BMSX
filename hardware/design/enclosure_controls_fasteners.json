  "assembly_sequence": [
    "Preassemble POWER30,15 to PA12 carrier with twoM2x6 and captured nuts; heads flushZ53.",
    "Insertbluecapfrominsidecase, flangeunderlip. Capcannotpullupthroughmouth.",
    "With the case open on the bench, heat-install four SPIROL151051 inserts from below flush at boss Z51 into 3.20..3.28mm blind pilot bores. Insert POWER cap from inside, then seat carrier ears on bosses and tighten four M2x6 cap screws upward with M2 washers. All heads remain inside, Z46.7..48.7; roof Z56 remains closed.",
    "Install RESET with supplied lockwasher/nut and anti-rotation flat; no whole-case IP rating implied.",
    "InstallretainedAPEMLEDin6.1hole; suppliednut/washerand0.04Nmexistinglimit.",
    "Wireandinsulateall5J60pins; continuitytestPOWER/OFF/RUN, RESETrelease/press andLEDpolarity beforepower."
  ],
  "service_sequence": [
    "Remove fixed body from base/boards before working on controls. From the open underside, undo four carrier M2 cap screws; retained roof inserts stay in the case. Capture POWER cap when carrier is released. No wiring runs to removable lid."
  ],
  "procurement_and_process_acceptance": [
    "Selected POWER part must remain within its exact configured -30..85C operating range. Measure its local temperature; this is not a global85C console rating. Maker lifetime/lower-temperature disagreements are recorded in reference/top_controls_selection.json.",
    "ProcureactualconfiguredPNPordercode andverifyfactorydrawing/samples. Familyconfigurationisnotastockavailabilitypromise.",
    "Verify3.3Vresetpullupcurrent<=10mAandgoldcontactlowlevelconditionsagainstnativepowerowner; no alteredrailpath.",
    "Checkactualterminalinsulationwithinexplicitbodies/fanouts, fullCAPstrokeandcapturedflangefit.",
    "MakerfasteningtorquelimitsarenotASA/PA12jointproof; no automaticwholecaseIP/ESD/thermalqualification."
  ],
  "fabrication_release": false
}
