	(title_block
		(title "R9 external local SRAM and read-only firmware flash")
		(date "2026-10-21")
		(rev "4ASIC ECO")
		(company "BMSX")
		(comment 1 "PROPOSED ASIC INTERFACES - NOT FOR MANUFACTURE"))
	(text "Within GFX, the GPU block alone owns external VRAM; the internal PCRTC block requests reads through GPU. No separate PCRTC package or PCB fetch bus.\nFlash WE_N remains tied V3V3; WP_N low protects the boot sector independently."
		(at 290 25.0 0)
		(effects
			(font
				(size 1.27 1.27)))
		(uuid a3f98d44-c0a0-5083-83fe-8f28da8d48fd))
	(text "10 ns SRAM and 70 ns flash need proven controller timing and turnaround; package data are not bus timing closure."
		(at 290 30.08 0)
		(effects
			(font
				(size 1.27 1.27)))
		(uuid c0be897d-98b4-59da-8013-4945aab136ce))
