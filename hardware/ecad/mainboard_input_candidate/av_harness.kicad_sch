	(text "J500 is an internal polarized 2x8 harness, not a SCART socket footprint. Retained panel wiring below is for the console/source SCART socket."
		(at 290 20.32 0)
		(effects
			(font
				(size 1.05 1.05)))
		(uuid 59baa35e-e999-5b80-981e-19da77655a00))
	(text "J500 -> SCART: 1/2 -> 15/13 (R/return); 3/4 -> 11/9 (G/return); 5/6 -> 7/5 (B/return); 7/8 -> 19/17 (CSYNC/return)."
		(at 290 25.4 0)
		(effects
			(font
				(size 1.05 1.05)))
		(uuid 31ee395f-148d-5db8-8290-a4965667c17c))
	(text "9/10 -> 3/4 (audio L/return); 11/12 -> 1/4 (audio R/return); 13/14 -> 16/18 (RGB select/return); 15/16 -> 21/21 (screen/return)."
		(at 290 30.48 0)
		(effects
			(font
				(size 1.05 1.05)))
		(uuid 7440d4f7-4cda-5c23-99a0-1e23653ac005))
	(text "SCART pin8 is unused; TV input is selected manually. No composite-video encoder. Use short shielded 75Ohm video leads; cable, ESD and EMC qualification remain open."
		(at 290 35.56 0)
		(effects
			(font
				(size 1.05 1.05)))
		(uuid 18522c4e-fd64-5a3b-9bd0-9927e9bac56e))
	(text "RGB outputs require local75Ohm shunts plus75Ohm TV loads. Complementary DAC loads remain37.4Ohm1%/0.125W; no connection or component-value changes in this ECO."
