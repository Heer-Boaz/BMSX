(version 1)
(rule "R4 local core and RAM fine-pitch escape"
 (condition "A.enclosedByArea('CORE_RAM_LOCAL') && B.enclosedByArea('CORE_RAM_LOCAL')")
 (constraint clearance (min 0.15mm)))

# Drill spacing is checked even when both vias carry the same net.
(rule "R4 minimum drilled hole separation"
 (constraint hole_to_hole (min 0.20mm)))

# R6 mounting-pad ownership rules
(rule "R6 H1_landing_area_R5: foreign or copper pads forbidden"
 (condition "A.Type == 'Pad' && A.intersectsArea('H1_landing_area_R5') && !(A.memberOfFootprint('H1') && A.Pad_Type == 'NPTH, mechanical')")
 (constraint disallow pad))

(rule "R6 H2_landing_area_R5: foreign or copper pads forbidden"
 (condition "A.Type == 'Pad' && A.intersectsArea('H2_landing_area_R5') && !(A.memberOfFootprint('H2') && A.Pad_Type == 'NPTH, mechanical')")
 (constraint disallow pad))

