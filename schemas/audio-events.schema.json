{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "https://bmsx.dev/schemas/audio-events.schema.json",
	"title": "BMSX Audio Event Map",
	"description": "Authoring contract compiled by the BMSX ROM tooling into a cartridge Audio Event Map.",
	"type": "object",
	"properties": {
		"events": {
			"type": "object",
			"additionalProperties": {
				"$ref": "#/definitions/audioEvent"
			}
		}
	},
	"required": [
		"events"
	],
	"additionalProperties": false,
	"definitions": {
		"assetId": {
			"type": "string",
			"minLength": 1
		},
		"audioEvent": {
			"type": "object",
			"properties": {
				"channel": {
					"type": "string",
					"enum": [
						"sfx",
						"music",
						"ui"
					]
				},
				"policy": {
					"type": "string",
					"enum": [
						"replace",
						"queue"
					]
				},
				"rules": {
					"type": "array",
					"minItems": 1,
					"items": {
						"$ref": "#/definitions/rule"
					}
				}
			},
			"required": [
				"channel",
				"rules"
			],
			"additionalProperties": false
		},
		"rule": {
			"type": "object",
			"properties": {
				"when": {
					"$ref": "#/definitions/matcher"
				},
				"go": {
					"$ref": "#/definitions/action"
				}
			},
			"required": [
				"go"
			],
			"additionalProperties": false
		},
		"matcher": {
			"type": "object",
			"properties": {
				"equals": {
					"type": "object"
				},
				"any_of": {
					"$ref": "#/definitions/matcherLists"
				},
				"in": {
					"$ref": "#/definitions/matcherLists"
				},
				"has_tag": {
					"type": "array"
				},
				"and": {
					"type": "array",
					"items": {
						"$ref": "#/definitions/matcher"
					}
				},
				"or": {
					"type": "array",
					"items": {
						"$ref": "#/definitions/matcher"
					}
				},
				"not": {
					"$ref": "#/definitions/matcher"
				}
			},
			"additionalProperties": false
		},
		"matcherLists": {
			"type": "object",
			"additionalProperties": {
				"type": "array"
			}
		},
		"action": {
			"oneOf": [
				{
					"$ref": "#/definitions/playAction"
				},
				{
					"$ref": "#/definitions/stopMusicAction"
				},
				{
					"$ref": "#/definitions/sequenceAction"
				},
				{
					"$ref": "#/definitions/randomAction"
				},
				{
					"$ref": "#/definitions/musicTransitionAction"
				}
			]
		},
		"playAction": {
			"type": "object",
			"properties": {
				"audio_id": {
					"$ref": "#/definitions/assetId"
				},
				"modulation_preset": {
					"type": "string",
					"minLength": 1
				},
				"modulation_params": {
					"$ref": "#/definitions/modulation"
				},
				"priority": {
					"type": "number",
					"minimum": 0
				},
				"cooldown_ms": {
					"type": "number",
					"minimum": 0
				}
			},
			"required": [
				"audio_id"
			],
			"not": {
				"required": [
					"modulation_preset",
					"modulation_params"
				]
			},
			"additionalProperties": false
		},
		"choiceAction": {
			"type": "object",
			"properties": {
				"audio_id": {
					"$ref": "#/definitions/assetId"
				},
				"modulation_preset": {
					"type": "string",
					"minLength": 1
				},
				"modulation_params": {
					"$ref": "#/definitions/modulation"
				},
				"priority": {
					"type": "number",
					"minimum": 0
				},
				"cooldown_ms": {
					"type": "number",
					"minimum": 0
				},
				"weight": {
					"type": "number",
					"minimum": 0
				}
			},
			"required": [
				"audio_id"
			],
			"not": {
				"required": [
					"modulation_preset",
					"modulation_params"
				]
			},
			"additionalProperties": false
		},
		"stopMusicAction": {
			"type": "object",
			"properties": {
				"stop_music": {
					"type": "object",
					"properties": {
						"fade_ms": {
							"type": "number",
							"minimum": 0
						}
					},
					"additionalProperties": false
				}
			},
			"required": [
				"stop_music"
			],
			"additionalProperties": false
		},
		"sequenceAction": {
			"type": "object",
			"properties": {
				"sequence": {
					"type": "array",
					"minItems": 1,
					"items": {
						"$ref": "#/definitions/action"
					}
				}
			},
			"required": [
				"sequence"
			],
			"additionalProperties": false
		},
		"randomAction": {
			"type": "object",
			"properties": {
				"one_of": {
					"type": "array",
					"minItems": 1,
					"items": {
						"$ref": "#/definitions/choiceAction"
					}
				},
				"pick": {
					"type": "string",
					"enum": [
						"uniform",
						"weighted"
					]
				},
				"avoid_repeat": {
					"type": "boolean"
				}
			},
			"required": [
				"one_of"
			],
			"additionalProperties": false
		},
		"musicTransitionAction": {
			"type": "object",
			"properties": {
				"music_transition": {
					"$ref": "#/definitions/musicTransition"
				}
			},
			"required": [
				"music_transition"
			],
			"additionalProperties": false
		},
		"musicTransition": {
			"type": "object",
			"properties": {
				"audio_id": {
					"$ref": "#/definitions/assetId"
				},
				"sync": {
					"oneOf": [
						{
							"type": "string",
							"enum": [
								"immediate",
								"loop"
							]
						},
						{
							"$ref": "#/definitions/stingerSync"
						}
					]
				},
				"fade_ms": {
					"type": "number",
					"minimum": 0
				},
				"crossfade_ms": {
					"type": "number",
					"minimum": 0
				},
				"start_at_loop_start": {
					"type": "boolean"
				},
				"start_fresh": {
					"type": "boolean"
				}
			},
			"anyOf": [
				{
					"required": [
						"audio_id"
					]
				},
				{
					"required": [
						"sync"
					],
					"properties": {
						"sync": {
							"allOf": [
								{
									"$ref": "#/definitions/stingerSync"
								},
								{
									"required": [
										"return_to"
									]
								}
							]
						}
					}
				}
			],
			"allOf": [
				{
					"not": {
						"required": [
							"fade_ms",
							"crossfade_ms"
						]
					}
				},
				{
					"not": {
						"properties": {
							"start_at_loop_start": {
								"const": true
							},
							"start_fresh": {
								"const": true
							}
						},
						"required": [
							"start_at_loop_start",
							"start_fresh"
						]
					}
				}
			],
			"additionalProperties": false
		},
		"stingerSync": {
			"type": "object",
			"properties": {
				"stinger": {
					"$ref": "#/definitions/assetId"
				},
				"return_to": {
					"$ref": "#/definitions/assetId"
				}
			},
			"required": [
				"stinger"
			],
			"additionalProperties": false
		},
		"modulation": {
			"type": "object",
			"properties": {
				"pitchDelta": {
					"type": "number"
				},
				"volumeDelta": {
					"type": "number"
				},
				"offset": {
					"type": "number"
				},
				"playbackRate": {
					"type": "number",
					"exclusiveMinimum": 0
				},
				"pitchRange": {
					"$ref": "#/definitions/numberRange"
				},
				"volumeRange": {
					"$ref": "#/definitions/numberRange"
				},
				"offsetRange": {
					"$ref": "#/definitions/numberRange"
				},
				"playbackRateRange": {
					"$ref": "#/definitions/numberRange"
				},
				"filter": {
					"$ref": "#/definitions/filter"
				}
			},
			"additionalProperties": false
		},
		"numberRange": {
			"type": "array",
			"minItems": 2,
			"maxItems": 2,
			"items": {
				"type": "number"
			}
		},
		"filter": {
			"type": "object",
			"properties": {
				"type": {
					"type": "string",
					"enum": [
						"lowpass",
						"highpass",
						"bandpass",
						"notch",
						"allpass",
						"peaking",
						"lowshelf",
						"highshelf"
					]
				},
				"frequency": {
					"type": "number",
					"exclusiveMinimum": 0,
					"exclusiveMaximum": 22050
				},
				"q": {
					"type": "number",
					"exclusiveMinimum": 0
				},
				"gain": {
					"type": "number"
				}
			},
			"required": [
				"type",
				"frequency",
				"q",
				"gain"
			],
			"additionalProperties": false
		}
	}
}
