{
	"version": "0.2.0",
	// NOTE — "Unable to attach to browser" fix (Windows VSCode + WSL workspace):
	// Root cause: browser launches were routed across the Windows<->WSL boundary via
	// js-debug-companion to your *Windows* Edge. With that Edge already running, the
	// new launch just forwarded its URL to the existing process and exited, so
	// js-debug had nothing to attach to ("Unable to attach to browser").
	// Fix: the Linux-side configs set "browserLaunchLocation": "workspace" (force the
	// browser onto the WSL/server side instead of the Windows UI side) together with
	// "runtimeExecutable" pointing at Microsoft Edge for Linux (installed in WSL).
	// js-debug then launches the browser *inside WSL* via WSLg, fully independent of
	// your Windows Edge — so you can leave your normal Edge open. No companion, no
	// cross-OS profile race. (Without browserLaunchLocation the runtimeExecutable path
	// is resolved on the Windows UI side → "spawn /usr/bin/microsoft-edge ENOENT".)
	// Configs also avoid a fixed `--remote-debugging-port` / `userDataDir`, so js-debug
	// uses a fresh free port + isolated temp profile each run. The `--disable-web-security`
	// / file-access flags still work (temp profile is non-default; the game persists no
	// localStorage/IndexedDB state).
	// NB: the `(WSL)` and `--app=\\wsl$\...` configs still target *Windows* Edge via the
	// companion and remain race-prone — prefer the runtimeExecutable ones below.
	"configurations": [
		{
			"type": "msedge",
			"request": "launch",
			"name": "Debug the game!",
			"url": "file://${workspaceFolder}/dist/index.html?rom=${input:romtobuild}.debug.rom",
			"runtimeExecutable": "/usr/bin/microsoft-edge",
			"browserLaunchLocation": "workspace",
			"runtimeArgs": [
				"--nolazy",
				"--allow-file-access-from-files",
				"--disable-session-crashed-bubble",
				"--disable-features=IsolateOrigins,site-per-process,web-security",
			],
			"webRoot": "${workspaceFolder}",
			"sourceMaps": true,
			"sourceMapPathOverrides": {
				"/home/boaz/BMSX/scripts/*": "${workspaceFolder}/scripts/*",
				// "file:///B:/BMSX/scripts/*": "${workspaceFolder}/scripts/*",
				// "../scripts/*": "${workspaceFolder}/scripts/*",
				"*": "${workspaceFolder}/*"
			},
			"showAsyncStacks": true,
			"smartStep": true,
			"disableNetworkCache": true,
			"timeout": 30000,
		},
		{
			"type": "msedge",
			"request": "launch",
			"name": "Run the game in non-debug mode!",
			"url": "file://${workspaceFolder}/dist/index.html?rom=${input:romtobuild}.rom",
			"runtimeExecutable": "/usr/bin/microsoft-edge",
			"browserLaunchLocation": "workspace",
			"runtimeArgs": [
				"--nolazy",
				"--allow-file-access-from-files",
				"--disable-session-crashed-bubble",
				"-inprivate"
			],
			"sourceMaps": true,
			"showAsyncStacks": true,
			"smartStep": true,
			"disableNetworkCache": true,
			"timeout": 30000,
			"presentation": {
				"hidden": false,
				"group": "",
				"order": 2
			}
		},
		{
			// Manual attach for Edge's own DevTools. Requires a browser already
			// listening on 9222; the launch configs no longer pin that port, so start
			// Edge yourself with `--remote-debugging-port=9222` first if you need this.
			"type": "msedge",
			"name": "Open Edge DevTools",
			"request": "attach",
			"url": "${workspaceFolder}/dist/index.html?rom=${input:romtobuild}.debug.rom",
			"port": 9222,
			"presentation": {
				"hidden": true
			}
		},
		{
			"type": "msedge",
			"request": "launch",
			"name": "Debug the game! (WSL)",
			"url": "file:////wsl$/Ubuntu/home/boaz/BMSX/dist/index.html?rom=${input:romtobuild}.debug.rom",
			"runtimeArgs": [
				"--nolazy",
				"--allow-file-access-from-files",
				"--disable-session-crashed-bubble",
				"--disable-features=IsolateOrigins,site-per-process,web-security",
				"--app=file:////wsl$/Ubuntu/home/boaz/BMSX/dist/index.html?rom=${input:romtobuild}.debug.rom"
			],
			"webRoot": "${workspaceFolder}",
			"sourceMaps": true,
			"sourceMapPathOverrides": {
				"file:///home/boaz/BMSX/scripts/*": "${workspaceFolder}/scripts/*",
				"/home/boaz/BMSX/scripts/*": "${workspaceFolder}/scripts/*",
				"*": "${workspaceFolder}/*"
			},
			"showAsyncStacks": true,
			"smartStep": true,
			"disableNetworkCache": true,
			"timeout": 30000
		},
		{
			"type": "msedge",
			"request": "launch",
			"name": "Debug the game from WSL Server!",
			"url": "http://localhost:8080/index.html?rom=${input:romtobuild}.debug.rom",
			// "runtimeExecutable": "/usr/bin/microsoft-edge",
			// "browserLaunchLocation": "workspace",
			"runtimeArgs": [
				"--nolazy",
				"--allow-file-access-from-files",
				"--disable-session-crashed-bubble",
				"--disable-features=IsolateOrigins,site-per-process,web-security",
				"--app=http://localhost:8080/index.html?rom=${input:romtobuild}.debug.rom"
			],
			"webRoot": "${workspaceFolder}",
			"sourceMaps": true,
			"sourceMapPathOverrides": {
				"file:///home/boaz/BMSX/scripts/*": "${workspaceFolder}/scripts/*",
				"/home/boaz/BMSX/scripts/*": "${workspaceFolder}/scripts/*",
				"*": "${workspaceFolder}/*"
			},
			"showAsyncStacks": false,
			"smartStep": true,
			"disableNetworkCache": true,
			"timeout": 30000,
		},
		{
			"type": "msedge",
			"request": "launch",
			"name": "Debug the game from WSL Server (NON-APP MODE)!",
			"url": "http://localhost:8080/index.html?rom=${input:romtobuild}.debug.rom",
			// "runtimeExecutable": "/usr/bin/microsoft-edge",
			// "browserLaunchLocation": "workspace",
			"runtimeArgs": [
				"--nolazy",
				"--allow-file-access-from-files",
				"--disable-session-crashed-bubble",
				"--disable-features=IsolateOrigins,site-per-process,web-security",
			],
			"webRoot": "${workspaceFolder}",
			"sourceMaps": true,
			"sourceMapPathOverrides": {
				"file:///home/boaz/BMSX/scripts/*": "${workspaceFolder}/scripts/*",
				"/home/boaz/BMSX/scripts/*": "${workspaceFolder}/scripts/*",
				"*": "${workspaceFolder}/*"
			},
			"showAsyncStacks": false,
			"smartStep": true,
			"disableNetworkCache": true,
			"timeout": 30000,
		},
		{
			"type": "msedge",
			"request": "launch",
			"name": "Release the game from WSL Server!",
			"url": "http://localhost:8080/index.html?rom=${input:romtobuild}.rom",
			"runtimeExecutable": "/usr/bin/microsoft-edge",
			"browserLaunchLocation": "workspace",
			"runtimeArgs": [
				"--nolazy",
				"--allow-file-access-from-files",
				"--disable-session-crashed-bubble",
				"--disable-features=IsolateOrigins,site-per-process,web-security",
				"--app=http://localhost:8080/index.html?rom=${input:romtobuild}.rom"
			],
			"webRoot": "${workspaceFolder}",
			"sourceMaps": true,
			"sourceMapPathOverrides": {
				"file:///home/boaz/BMSX/scripts/*": "${workspaceFolder}/scripts/*",
				"/home/boaz/BMSX/scripts/*": "${workspaceFolder}/scripts/*",
				"*": "${workspaceFolder}/*"
			},
			"showAsyncStacks": false,
			"smartStep": true,
			"disableNetworkCache": true,
			"timeout": 30000,
		},
		{
			"type": "pwa-node",
			"request": "launch",
			"name": "LIBRETRO DEBUG: RetroArch",
			"runtimeExecutable": "npm",
			"runtimeArgs": [
				"run",
				"run:retroarch",
				"--",
				"./dist/${input:romtobuild}.debug.rom"
			],
			"cwd": "${workspaceFolder}",
			"console": "integratedTerminal"
		},
		{
			"type": "pwa-node",
			"request": "launch",
			"name": "LIBRETRO DEBUG: Custom Host (SDL)",
			"runtimeExecutable": "npm",
			"runtimeArgs": [
				"run",
				"run:libretro-host:wsl:sdl",
				"--",
				"./dist/${input:romtobuild}.debug.rom",
			],
			"cwd": "${workspaceFolder}",
			"console": "integratedTerminal"
		},
		{
			"type": "pwa-node",
			"request": "launch",
			"name": "LIBRETRO RELEASE: Custom Host (SDL)",
			"runtimeExecutable": "npm",
			"runtimeArgs": [
				"run",
				"run:libretro-host:wsl:sdl",
				"--",
				"./dist/${input:romtobuild}.rom",
			],
			"cwd": "${workspaceFolder}",
			"console": "integratedTerminal"
		},
		{
			"type": "pwa-node",
			"request": "launch",
			"name": "LIBRETRO DEBUG: Custom Host (FB)",
			"runtimeExecutable": "npm",
			"runtimeArgs": [
				"run",
				"run:libretro-host:wsl:fb",
				"--",
				"./dist/${input:romtobuild}.debug.rom",
			],
			"cwd": "${workspaceFolder}",
			"console": "integratedTerminal"
		},
		{
			"type": "pwa-node",
			"request": "launch",
			"name": "GAME RUN: headless",
			"runtimeExecutable": "npm",
			"runtimeArgs": [
				"run",
				"headless:game",
				"--",
				"${input:romtobuild}"
			],
			"cwd": "${workspaceFolder}",
			"console": "integratedTerminal"
		}
	],
	"inputs": [
		{
			"type": "pickString",
			"id": "romtobuild",
			"description": "Choose cart to debug/run",
			"options": [
				"bare_metal_cart",
				"fade_probe",
				"pietious",
				"nemesis_s",
				"esther",
				"2025",
				"emptycart",
				"sint2024",
				"ella2023",
				"testrom",
				"joanneke2022",
				"marlies2021",
				"marlies2020",
				"sintervania"
			],
			"default": "bare_metal_cart"
		}
	],
}
