{
	"typescript.tsdk": "node_modules/typescript/lib",
	"yaml.disableAdditionalProperties": true,
	"yaml.format.singleQuote": true,
	"yaml.schemas": {
		"./schemas/audio-events.schema.json": ["**/*.aem.yaml", "**/*.aem.yml"]
	},
	"json.schemas": [
		{
			"fileMatch": ["*.aem.json"],
			"url": "./schemas/audio-events.schema.json"
		}
	],
	"cmake.sourceDirectory": "${workspaceFolder}/machine/cpp"
	,
	"js_repl_node_path": "node",
	"typescript.native-preview.tsdk": "node_modules/@typescript/native-preview"
}
