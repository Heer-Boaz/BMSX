title: Maze of Pietious
gx_vram_layout:
    framebuffers:
        - { x: 0, y: 0, width: 256, height: 192 }
        - { x: 256, y: 0, width: 256, height: 192 }
    reserved:
        system: { x: 704, y: 720, width: 320, height: 304 }
    slots:
        sprites:
            texture: { x: 512, y: 256, width: 512, height: 192 }
            clut: { x: 512, y: 448, width: 16, height: 1 }
        boss:
            texture: { x: 512, y: 456, width: 512, height: 64 }
        cinematic:
            texture: { x: 0, y: 256, width: 256, height: 192 }
    groups:
        0: { mode: palette4, slots: [sprites], page_local: true }
        1: { mode: direct16, slots: [boss], page_local: true }
        2: { mode: direct16, slots: [cinematic], page_local: true }
        3: { mode: direct16, slots: [cinematic], page_local: true }
    working_sets:
        gameplay: [sprites, boss]
        intro: [sprites, cinematic]
        end_demo: [sprites, cinematic]
