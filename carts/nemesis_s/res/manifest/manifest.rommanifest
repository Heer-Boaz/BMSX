title: Nemesis S - Nemesis 2 Baseline
short_name: 'nemesis_s'
rom_name: 'nemesis_s'
machine:
    namespace: 'nemesis_s'
    vdp_class: psx
lua:
    entry_path: cart.lua
gx_texture_layout:
    reserved:
        framebuffer: { x: 0, y: 0, width: 256, height: 192 }
        system: { x: 512, y: 0, width: 256, height: 64 }
    slots:
        stage:
            texture: { x: 0, y: 256, width: 1024, height: 256 }
    groups:
        0: { mode: direct16, slots: [stage], page_local: true }
    working_sets:
        stage: [stage]
