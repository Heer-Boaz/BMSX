{
	"extends": "../tsconfig.base.json",
	"compilerOptions": {
		"composite": false,
		"noEmit": true,
		"strict": false,
		"noImplicitAny": false,
		"noImplicitThis": false,
		"skipLibCheck": true,
		"types": ["node"],
		"rootDir": "../"
	},
	"include": [
		"**/*.ts",
		"../machine/ts/**/*.d.ts"
	],
	"exclude": ["../machine/ts/bmsx.js", "../machine/ts/bmsx.d.ts", "../tests/**.*", "./scripts/**.*"]
}
