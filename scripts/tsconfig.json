{
	"extends": "../tsconfig.base.json", // path to the main tsconfig.json file
	"compilerOptions": {
	"composite": false,
	"noEmit": true,
	"strict": false,
	"noImplicitAny": false,
	"noImplicitThis": false,
	"skipLibCheck": true,
	"types": ["node"],
	"rootDir": "../"
	},
	"include": [
	"**/*.ts",
	"../packages/bmsx-console/src/**/*.d.ts"
	],
	"exclude": ["../packages/bmsx-console/src/bmsx.js", "../packages/bmsx-console/src/bmsx.d.ts", "../tests/**.*", "./scripts/**.*"]
}
