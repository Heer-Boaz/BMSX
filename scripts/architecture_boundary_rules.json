{
	"roots": [
		"machine/ts",
		"toolchain/ts",
		"tooling/ts",
		"machine/cpp",
		"ide",
		"hosts/common",
		"hosts/browser",
		"hosts/node",
		"hosts/libretro",
		"hosts/libretro_host",
		"scripts/bootrom/platforms",
		"scripts/products",
		"scripts/rompacker",
		"scripts/tooling"
	],
	"tsAliases": [
		{ "from": "bmsx", "to": "machine/ts/index.ts" },
		{ "from": "bmsx/", "to": "machine/ts/" },
		{ "from": "bmsx-browser-host/", "to": "hosts/browser/" },
		{ "from": "bmsx-node-host/", "to": "hosts/node/" }
	],
	"cppIncludeRoots": [
		"machine/cpp",
		"hosts/libretro",
		"hosts/libretro_host"
	],
	"layers": [
		{ "name": "ts-machine-spec", "paths": ["machine/ts/spec/**"] },
		{ "name": "ts-runtime-tooling", "paths": ["tooling/ts/runtime/**"] },
		{ "name": "ts-gx-machine", "paths": ["machine/ts/machine/devices/gx/**"] },
		{ "name": "ts-gx-webgl-render", "paths": ["machine/ts/render/backend/webgl/gx_gpu.ts"] },
		{ "name": "ts-software-render", "paths": ["machine/ts/render/backend/software/**"] },
		{ "name": "ts-machine", "paths": ["machine/ts/machine/**"] },
		{ "name": "ts-blua-toolchain", "paths": ["toolchain/ts/lua/**"] },
		{ "name": "ts-rompack-toolchain", "paths": ["toolchain/ts/rompack/**"] },
		{ "name": "ts-rompack", "paths": ["machine/ts/rompack/**"] },
		{ "name": "ts-runtime-api", "paths": ["machine/ts/*.ts"] },
		{ "name": "ts-core", "paths": ["machine/ts/core/**"] },
		{ "name": "ts-studio-composition", "paths": ["ide/browser/**", "ide/workbench/machine_runtime.ts", "ide/workbench/host_frame.ts"] },
		{ "name": "ts-ide", "paths": ["ide/**"] },
		{ "name": "ts-host-audio", "paths": ["hosts/common/audio_output.ts"] },
		{ "name": "ts-frontend-input", "paths": ["hosts/common/input/**"] },
		{ "name": "ts-host-contracts", "paths": ["hosts/common/clock.ts", "hosts/common/frame_loop.ts", "hosts/common/log.ts"] },
		{ "name": "ts-host-common", "paths": ["hosts/common/**"] },
		{ "name": "ts-browser-host", "paths": ["hosts/browser/**"] },
		{ "name": "ts-node-launch", "paths": ["scripts/bootrom/platforms/node_launch.ts", "scripts/bootrom/platforms/node_option_values.ts"] },
		{ "name": "ts-node-player-entry", "paths": ["scripts/bootrom/platforms/node_entry.ts"] },
		{ "name": "ts-node-tooling", "paths": ["scripts/bootrom/platforms/node_tooling_entry.ts", "scripts/bootrom/platforms/node_tooling_options.ts", "scripts/bootrom/platforms/node_workspace_bridge.ts", "scripts/bootrom/platforms/input_timeline.ts", "scripts/bootrom/platforms/headless_capture.ts", "scripts/bootrom/platforms/hostrunner/**"] },
		{ "name": "ts-node-host", "paths": ["hosts/node/**"] },
		{ "name": "ts-product-build", "paths": ["scripts/products/**"] },
		{ "name": "ts-rompacker-tool", "paths": ["scripts/rompacker/**"] },
		{ "name": "ts-tooling-common", "paths": ["scripts/tooling/**"] },
		{ "name": "ts-render", "paths": ["machine/ts/render/**"] },
		{ "name": "ts-audio", "paths": ["machine/ts/audio/**"] },
		{ "name": "ts-common", "paths": ["machine/ts/common/**"] },

		{ "name": "cpp-machine-spec", "paths": ["machine/cpp/spec/**"] },
		{ "name": "cpp-gx-machine", "paths": ["machine/cpp/machine/devices/gx/**"] },
		{ "name": "cpp-gx-gles2-render", "paths": ["machine/cpp/render/backend/gles2/gx_gpu.cpp", "machine/cpp/render/backend/gles2/gx_gpu.h"] },
		{ "name": "cpp-software-render", "paths": ["machine/cpp/render/backend/software/**"] },
		{ "name": "cpp-machine", "paths": ["machine/cpp/machine/**"] },
		{ "name": "cpp-rompack", "paths": ["machine/cpp/rompack/**"] },
		{ "name": "cpp-core", "paths": ["machine/cpp/core/**"] },
		{ "name": "cpp-render", "paths": ["machine/cpp/render/**"] },
		{ "name": "cpp-audio", "paths": ["machine/cpp/audio/**"] },
		{ "name": "cpp-lua", "paths": ["machine/cpp/lua/**"] },
		{ "name": "cpp-common", "paths": ["machine/cpp/common/**"] },
		{ "name": "cpp-libretro-host", "paths": ["hosts/libretro/**"] },
		{ "name": "cpp-direct-host", "paths": ["hosts/libretro_host/**"] }
	],
	"rules": [
		{
			"from": "ts-machine-spec",
			"deny": ["ts-runtime-tooling", "ts-gx-machine", "ts-machine", "ts-blua-toolchain", "ts-rompack-toolchain", "ts-rompack", "ts-runtime-api", "ts-core", "ts-studio-composition", "ts-ide", "ts-host-contracts", "ts-host-common", "ts-browser-host", "ts-node-launch", "ts-node-player-entry", "ts-node-tooling", "ts-node-host", "ts-product-build", "ts-rompacker-tool", "ts-tooling-common", "ts-render", "ts-frontend-input", "ts-audio", "ts-host-audio"],
			"reason": "TS machine specification files are dependency leaves shared by producers and consumers; they must not import emulator, compiler, tooling, host, IDE, or product implementation."
		},
		{
			"from": "ts-runtime-tooling",
			"deny": ["ts-core", "ts-ide", "ts-studio-composition", "ts-host-contracts", "ts-host-common", "ts-browser-host", "ts-node-launch", "ts-node-player-entry", "ts-node-tooling", "ts-node-host", "ts-product-build", "ts-blua-toolchain", "ts-rompack-toolchain", "ts-rompacker-tool", "ts-tooling-common", "ts-render", "ts-frontend-input", "ts-audio", "ts-host-audio"],
			"reason": "Suspended runtime tooling may consume machine state but must not depend on Studio, compiler, product, host, or backend implementation."
		},
		{
			"from": "ts-gx-machine",
			"deny": ["ts-runtime-tooling", "ts-core", "ts-ide", "ts-host-contracts", "ts-host-common", "ts-blua-toolchain", "ts-rompack-toolchain", "ts-render", "ts-gx-webgl-render", "ts-software-render", "ts-frontend-input", "ts-audio", "ts-host-audio"],
			"reason": "TS GX machine code must emit the GPU command contract, not depend on render backends."
		},
		{
			"from": "ts-gx-webgl-render",
			"deny": ["ts-runtime-tooling", "ts-software-render"],
			"reason": "TS GX WebGL must remain a host-GPU accelerated backend, not import software rendering."
		},
		{
			"from": "ts-software-render",
			"deny": ["ts-runtime-tooling"],
			"reason": "TS software rendering consumes machine render state without depending on Studio runtime tooling."
		},
		{
			"from": "ts-machine",
			"deny": ["ts-runtime-tooling", "ts-core", "ts-ide", "ts-host-contracts", "ts-host-common", "ts-blua-toolchain", "ts-rompack-toolchain", "ts-render", "ts-gx-webgl-render", "ts-software-render", "ts-frontend-input", "ts-audio", "ts-host-audio"],
			"reason": "TS machine code must stay below host, IDE, render, input, audio, and language layers."
		},
		{
			"from": "ts-blua-toolchain",
			"deny": ["ts-runtime-tooling", "ts-rompack-toolchain", "ts-machine", "ts-core", "ts-ide", "ts-studio-composition", "ts-host-contracts", "ts-host-common", "ts-browser-host", "ts-node-launch", "ts-node-player-entry", "ts-node-tooling", "ts-node-host", "ts-product-build", "ts-render", "ts-frontend-input", "ts-audio", "ts-host-audio"],
			"reason": "The BLua frontend and compiler produce object code from machine specification contracts; they must not depend on ROM authoring, emulator, product, host, IDE, or backend implementation."
		},
		{
			"from": "ts-rompack-toolchain",
			"deny": ["ts-runtime-tooling", "ts-machine", "ts-core", "ts-ide", "ts-studio-composition", "ts-host-contracts", "ts-host-common", "ts-browser-host", "ts-node-launch", "ts-node-player-entry", "ts-node-tooling", "ts-node-host", "ts-product-build", "ts-render", "ts-frontend-input", "ts-audio", "ts-host-audio"],
			"reason": "ROM authoring consumes BLua object code and machine wire contracts; it must not depend on emulator, product, host, IDE, or backend implementation."
		},
		{
			"from": "ts-rompack",
			"deny": ["ts-runtime-tooling", "ts-machine", "ts-core", "ts-ide", "ts-host-contracts", "ts-host-common", "ts-blua-toolchain", "ts-rompack-toolchain", "ts-render", "ts-gx-webgl-render", "ts-software-render", "ts-frontend-input", "ts-audio", "ts-host-audio"],
			"reason": "TS ROM wire-format code must not depend on emulator, core, host, IDE, render, input, audio, or language implementation."
		},
		{
			"from": "ts-core",
			"deny": ["ts-runtime-tooling", "ts-blua-toolchain", "ts-rompack-toolchain", "ts-ide", "ts-host-contracts", "ts-host-common", "ts-node-tooling"],
			"reason": "TS core owns machine construction from raw ROM media; authoring metadata, compiler, IDE, application, and validation tooling compose above it."
		},
		{
			"from": "ts-runtime-api",
			"deny": ["ts-runtime-tooling", "ts-ide", "ts-host-contracts", "ts-host-common"],
			"reason": "TS runtime entrypoints must stay below the IDE composition layer."
		},
		{
			"from": "ts-render",
			"deny": ["ts-runtime-tooling", "ts-ide", "ts-host-contracts", "ts-host-common"],
			"reason": "TS render primitives and backends consume mirrored render contracts and must not depend on host or IDE policy."
		},
		{
			"from": "ts-ide",
			"deny": ["ts-host-common"],
			"reason": "IDE features receive their session dependencies from the application composition owner; they do not reach back into it."
		},
		{
			"from": "ts-host-common",
			"deny": ["ts-runtime-tooling", "ts-ide", "ts-studio-composition", "ts-blua-toolchain", "ts-rompack-toolchain", "ts-node-tooling"],
			"reason": "The player composition must not depend on Studio, IDE, compiler, or tooling implementation."
		},
		{
			"from": "ts-browser-host",
			"deny": ["ts-runtime-tooling", "ts-ide", "ts-studio-composition", "ts-blua-toolchain", "ts-rompack-toolchain", "ts-node-tooling"],
			"reason": "The browser player host must remain usable without Studio, IDE, compiler, or tooling implementation."
		},
		{
			"from": "ts-node-launch",
			"deny": ["ts-runtime-tooling", "ts-ide", "ts-studio-composition", "ts-blua-toolchain", "ts-rompack-toolchain", "ts-node-tooling"],
			"reason": "Shared Node launch parsing and artifact selection must stay independent from Studio and validation tooling."
		},
		{
			"from": "ts-node-player-entry",
			"deny": ["ts-runtime-tooling", "ts-ide", "ts-studio-composition", "ts-blua-toolchain", "ts-rompack-toolchain", "ts-node-tooling"],
			"reason": "The Node player entrypoint must remain usable without Studio, IDE, compiler, or test-tooling implementation."
		},
		{
			"from": "ts-node-host",
			"deny": ["ts-runtime-tooling", "ts-ide", "ts-studio-composition", "ts-blua-toolchain", "ts-rompack-toolchain", "ts-node-tooling"],
			"reason": "The Node host implementation must not depend on Studio, IDE, compiler, or test-tooling implementation."
		},
		{
			"from": "ts-rompacker-tool",
			"deny": ["ts-runtime-tooling", "ts-machine", "ts-core", "ts-product-build", "ts-ide", "ts-studio-composition", "ts-host-common", "ts-browser-host", "ts-node-launch", "ts-node-player-entry", "ts-node-tooling", "ts-node-host"],
			"reason": "ROM and source tooling must not depend on emulator, core, deployable products, hosts, runtime composition, Studio, or host validation tooling."
		},
		{
			"from": "ts-host-audio",
			"deny": ["ts-runtime-tooling"],
			"reason": "Host audio remains independent from Studio runtime tooling."
		},
		{
			"from": "ts-frontend-input",
			"deny": ["ts-runtime-tooling"],
			"reason": "Frontend input remains independent from Studio runtime tooling."
		},
		{
			"from": "ts-host-contracts",
			"deny": ["ts-runtime-tooling"],
			"reason": "Host contracts remain below Studio runtime tooling."
		},
		{
			"from": "ts-product-build",
			"deny": ["ts-runtime-tooling"],
			"reason": "Product builders select entrypoints without depending on Studio runtime tooling implementation."
		},
		{
			"from": "ts-tooling-common",
			"deny": ["ts-runtime-tooling"],
			"reason": "Shared build tooling remains below Studio runtime tooling."
		},
		{
			"from": "ts-audio",
			"deny": ["ts-runtime-tooling"],
			"reason": "Machine audio support remains independent from Studio runtime tooling."
		},
		{
			"from": "ts-common",
			"deny": ["ts-runtime-tooling"],
			"reason": "Machine common utilities remain dependency leaves below Studio runtime tooling."
		},
		{
			"from": "cpp-machine-spec",
			"deny": ["cpp-gx-machine", "cpp-machine", "cpp-rompack", "cpp-core", "cpp-render", "cpp-audio", "cpp-lua", "cpp-libretro-host", "cpp-direct-host"],
			"reason": "C++ machine specification files are dependency leaves shared by producers and consumers; they must not include emulator, tooling, host, or product implementation."
		},
		{
			"from": "cpp-gx-machine",
			"deny": ["cpp-core", "cpp-render", "cpp-gx-gles2-render", "cpp-software-render", "cpp-audio", "cpp-libretro-host", "cpp-direct-host"],
			"reason": "C++ GX machine code must emit the GPU command contract, not depend on render backends."
		},
		{
			"from": "cpp-gx-gles2-render",
			"deny": ["cpp-software-render", "cpp-libretro-host", "cpp-direct-host"],
			"reason": "C++ GX GLES2 must remain a host-GPU accelerated backend, not include software rendering."
		},
		{
			"from": "cpp-machine",
			"deny": ["cpp-core", "cpp-render", "cpp-gx-gles2-render", "cpp-software-render", "cpp-audio", "cpp-libretro-host", "cpp-direct-host"],
			"reason": "C++ machine code must stay below host, render, input, and audio edge layers."
		},
		{
			"from": "cpp-core",
			"deny": ["cpp-libretro-host", "cpp-direct-host"],
			"reason": "C++ core construction must remain usable without a concrete frontend product."
		},
		{
			"from": "cpp-render",
			"deny": ["cpp-libretro-host", "cpp-direct-host"],
			"reason": "C++ render code consumes its output contract without depending on a concrete frontend."
		},
		{
			"from": "cpp-rompack",
			"deny": ["cpp-machine", "cpp-core", "cpp-render", "cpp-gx-gles2-render", "cpp-software-render", "cpp-audio", "cpp-libretro-host", "cpp-direct-host"],
			"reason": "C++ ROM wire-format code must not depend on emulator, core, host, render, input, or audio implementation."
		}
	]
}
