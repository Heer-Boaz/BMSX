{
	"roots": [
		"machine/ts",
		"machine/cpp",
		"ide",
		"hosts/common",
		"hosts/browser",
		"hosts/node",
		"hosts/libretro",
		"scripts/bootrom/platforms",
		"scripts/products",
		"scripts/rompacker",
		"scripts/tooling"
	],
	"tsAliases": [
		{ "from": "bmsx", "to": "machine/ts/index.ts" },
		{ "from": "bmsx/", "to": "machine/ts/" },
		{ "from": "bmsx-browser-host/", "to": "hosts/browser/" },
		{ "from": "bmsx-node-host/", "to": "hosts/node/" }
	],
	"cppIncludeRoots": [
		"machine/cpp",
		"hosts/libretro",
		"hosts/libretro_host"
	],
	"layers": [
		{ "name": "ts-machine-spec", "paths": ["machine/ts/spec/**"] },
		{ "name": "ts-gx-machine", "paths": ["machine/ts/machine/devices/gx/**"] },
		{ "name": "ts-gx-webgl-render", "paths": ["machine/ts/render/backend/webgl/gx_gpu.ts"] },
		{ "name": "ts-software-render", "paths": ["machine/ts/render/backend/software/**"] },
		{ "name": "ts-machine", "paths": ["machine/ts/machine/**"] },
		{ "name": "ts-rompack-tooling", "paths": ["machine/ts/rompack/tooling/**"] },
		{ "name": "ts-rompack", "paths": ["machine/ts/rompack/**"] },
		{ "name": "ts-lua-compiler", "paths": ["machine/ts/lua/compiler.ts", "machine/ts/lua/compiler/**"] },
		{ "name": "ts-runtime-api", "paths": ["machine/ts/*.ts"] },
		{ "name": "ts-core", "paths": ["machine/ts/core/**"] },
		{ "name": "ts-studio-composition", "paths": ["ide/browser/**", "ide/workbench/machine_runtime.ts", "ide/workbench/host_frame.ts"] },
		{ "name": "ts-ide", "paths": ["ide/**"] },
		{ "name": "ts-host-audio", "paths": ["hosts/common/audio_output.ts"] },
		{ "name": "ts-host-common", "paths": ["hosts/common/**"] },
		{ "name": "ts-browser-host", "paths": ["hosts/browser/**"] },
		{ "name": "ts-node-launch", "paths": ["scripts/bootrom/platforms/node_launch.ts", "scripts/bootrom/platforms/node_option_values.ts"] },
		{ "name": "ts-node-player-entry", "paths": ["scripts/bootrom/platforms/node_entry.ts"] },
		{ "name": "ts-node-tooling", "paths": ["scripts/bootrom/platforms/node_tooling_entry.ts", "scripts/bootrom/platforms/node_tooling_options.ts", "scripts/bootrom/platforms/node_workspace_bridge.ts", "scripts/bootrom/platforms/input_timeline.ts", "scripts/bootrom/platforms/headless_capture.ts", "scripts/bootrom/platforms/hostrunner/**"] },
		{ "name": "ts-node-host", "paths": ["hosts/node/**"] },
		{ "name": "ts-product-build", "paths": ["scripts/products/**"] },
		{ "name": "ts-rompacker-tool", "paths": ["scripts/rompacker/**"] },
		{ "name": "ts-tooling-common", "paths": ["scripts/tooling/**"] },
		{ "name": "ts-render", "paths": ["machine/ts/render/**"] },
		{ "name": "ts-platform", "paths": ["machine/ts/platform/**"] },
		{ "name": "ts-input", "paths": ["machine/ts/input/**"] },
		{ "name": "ts-audio", "paths": ["machine/ts/audio/**"] },
		{ "name": "ts-language", "paths": ["machine/ts/language/**"] },
		{ "name": "ts-lua", "paths": ["machine/ts/lua/**"] },
		{ "name": "ts-common", "paths": ["machine/ts/common/**"] },

		{ "name": "cpp-machine-spec", "paths": ["machine/cpp/spec/**"] },
		{ "name": "cpp-gx-machine", "paths": ["machine/cpp/machine/devices/gx/**"] },
		{ "name": "cpp-gx-gles2-render", "paths": ["machine/cpp/render/backend/gles2/gx_gpu.cpp", "machine/cpp/render/backend/gles2/gx_gpu.h"] },
		{ "name": "cpp-software-render", "paths": ["machine/cpp/render/backend/software/**"] },
		{ "name": "cpp-machine", "paths": ["machine/cpp/machine/**"] },
		{ "name": "cpp-rompack", "paths": ["machine/cpp/rompack/**"] },
		{ "name": "cpp-core", "paths": ["machine/cpp/core/**"] },
		{ "name": "cpp-render", "paths": ["machine/cpp/render/**"] },
		{ "name": "cpp-platform", "paths": ["machine/cpp/platform/**"] },
		{ "name": "cpp-input", "paths": ["machine/cpp/input/**"] },
		{ "name": "cpp-audio", "paths": ["machine/cpp/audio/**"] },
		{ "name": "cpp-lua", "paths": ["machine/cpp/lua/**"] },
		{ "name": "cpp-common", "paths": ["machine/cpp/common/**"] }
	],
	"rules": [
		{
			"from": "ts-machine-spec",
			"deny": ["ts-gx-machine", "ts-machine", "ts-rompack-tooling", "ts-rompack", "ts-lua-compiler", "ts-runtime-api", "ts-core", "ts-studio-composition", "ts-ide", "ts-host-common", "ts-browser-host", "ts-node-launch", "ts-node-player-entry", "ts-node-tooling", "ts-node-host", "ts-product-build", "ts-rompacker-tool", "ts-tooling-common", "ts-render", "ts-platform", "ts-input", "ts-audio", "ts-host-audio", "ts-language", "ts-lua"],
			"reason": "TS machine specification files are dependency leaves shared by producers and consumers; they must not import emulator, compiler, tooling, host, IDE, or product implementation."
		},
		{
			"from": "ts-gx-machine",
			"deny": ["ts-core", "ts-ide", "ts-host-common", "ts-render", "ts-gx-webgl-render", "ts-software-render", "ts-platform", "ts-input", "ts-audio", "ts-host-audio", "ts-language"],
			"reason": "TS GX machine code must emit the GPU command contract, not depend on render backends."
		},
		{
			"from": "ts-gx-webgl-render",
			"deny": ["ts-software-render"],
			"reason": "TS GX WebGL must remain a host-GPU accelerated backend, not import software rendering."
		},
		{
			"from": "ts-machine",
			"deny": ["ts-core", "ts-ide", "ts-host-common", "ts-render", "ts-gx-webgl-render", "ts-software-render", "ts-platform", "ts-input", "ts-audio", "ts-host-audio", "ts-language"],
			"reason": "TS machine code must stay below host, IDE, render, input, audio, and language layers."
		},
		{
			"from": "ts-lua-compiler",
			"deny": ["ts-machine", "ts-core"],
			"reason": "The BLua32 compiler produces machine words from specification contracts; it must not depend on emulator or core implementation."
		},
		{
			"from": "ts-rompack-tooling",
			"deny": ["ts-machine", "ts-core"],
			"reason": "ROM tooling produces and inspects media through shared specification contracts; it must not depend on emulator or core implementation."
		},
		{
			"from": "ts-rompack",
			"deny": ["ts-machine", "ts-core", "ts-ide", "ts-host-common", "ts-render", "ts-gx-webgl-render", "ts-software-render", "ts-platform", "ts-input", "ts-audio", "ts-host-audio", "ts-language"],
			"reason": "TS ROM wire-format code must not depend on emulator, core, host, IDE, render, input, audio, or language implementation."
		},
		{
			"from": "ts-core",
			"deny": ["ts-rompack-tooling", "ts-lua-compiler", "ts-ide", "ts-host-common", "ts-node-tooling"],
			"reason": "TS core owns machine construction from raw ROM media; authoring metadata, compiler, IDE, application, and validation tooling compose above it."
		},
		{
			"from": "ts-runtime-api",
			"deny": ["ts-ide", "ts-host-common"],
			"reason": "TS runtime entrypoints must stay below the IDE composition layer."
		},
		{
			"from": "ts-render",
			"deny": ["ts-ide", "ts-host-common"],
			"reason": "TS render primitives and backends must not depend on IDE presentation policy."
		},
		{
			"from": "ts-ide",
			"deny": ["ts-host-common"],
			"reason": "IDE features receive their session dependencies from the application composition owner; they do not reach back into it."
		},
		{
			"from": "ts-host-common",
			"deny": ["ts-ide", "ts-studio-composition", "ts-lua-compiler", "ts-rompack-tooling", "ts-node-tooling"],
			"reason": "The player composition must not depend on Studio, IDE, compiler, or tooling implementation."
		},
		{
			"from": "ts-browser-host",
			"deny": ["ts-ide", "ts-studio-composition", "ts-lua-compiler", "ts-rompack-tooling", "ts-node-tooling"],
			"reason": "The browser player host must remain usable without Studio, IDE, compiler, or tooling implementation."
		},
		{
			"from": "ts-node-launch",
			"deny": ["ts-ide", "ts-studio-composition", "ts-lua-compiler", "ts-rompack-tooling", "ts-node-tooling"],
			"reason": "Shared Node launch parsing and artifact selection must stay independent from Studio and validation tooling."
		},
		{
			"from": "ts-node-player-entry",
			"deny": ["ts-ide", "ts-studio-composition", "ts-lua-compiler", "ts-rompack-tooling", "ts-node-tooling"],
			"reason": "The Node player entrypoint must remain usable without Studio, IDE, compiler, or test-tooling implementation."
		},
		{
			"from": "ts-node-host",
			"deny": ["ts-ide", "ts-studio-composition", "ts-lua-compiler", "ts-rompack-tooling", "ts-node-tooling"],
			"reason": "Node platform services must not depend on Studio, IDE, compiler, or test-tooling implementation."
		},
		{
			"from": "ts-rompacker-tool",
			"deny": ["ts-machine", "ts-core", "ts-product-build", "ts-ide", "ts-studio-composition", "ts-host-common", "ts-browser-host", "ts-node-launch", "ts-node-player-entry", "ts-node-tooling", "ts-node-host"],
			"reason": "ROM and source tooling must not depend on emulator, core, deployable products, hosts, runtime composition, Studio, or host validation tooling."
		},
		{
			"from": "cpp-machine-spec",
			"deny": ["cpp-gx-machine", "cpp-machine", "cpp-rompack", "cpp-core", "cpp-render", "cpp-platform", "cpp-input", "cpp-audio", "cpp-lua"],
			"reason": "C++ machine specification files are dependency leaves shared by producers and consumers; they must not include emulator, tooling, host, or product implementation."
		},
		{
			"from": "cpp-gx-machine",
			"deny": ["cpp-core", "cpp-render", "cpp-gx-gles2-render", "cpp-software-render", "cpp-platform", "cpp-input", "cpp-audio"],
			"reason": "C++ GX machine code must emit the GPU command contract, not depend on render backends."
		},
		{
			"from": "cpp-gx-gles2-render",
			"deny": ["cpp-software-render"],
			"reason": "C++ GX GLES2 must remain a host-GPU accelerated backend, not include software rendering."
		},
		{
			"from": "cpp-machine",
			"deny": ["cpp-core", "cpp-render", "cpp-gx-gles2-render", "cpp-software-render", "cpp-platform", "cpp-input", "cpp-audio"],
			"reason": "C++ machine code must stay below host, render, platform, input, and audio edge layers."
		},
		{
			"from": "cpp-rompack",
			"deny": ["cpp-machine", "cpp-core", "cpp-render", "cpp-gx-gles2-render", "cpp-software-render", "cpp-platform", "cpp-input", "cpp-audio"],
			"reason": "C++ ROM wire-format code must not depend on emulator, core, host, render, platform, input, or audio implementation."
		}
	]
}
