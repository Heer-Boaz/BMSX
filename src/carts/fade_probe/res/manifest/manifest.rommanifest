machine:
    render_size: {width: 160, height: 120}
    namespace: 'fade_probe'
    ufps: 50000000
    specs:
        cpu:
            cpu_freq_hz: 1000000 # 1 MHz
            imgdec_bytes_per_sec: 26214400
        dma:
